apiVersion: v1
kind: Namespace
metadata:
  name: {{ journal_forwarder_k3s_event_exporter_namespace }}
  labels:
    app.kubernetes.io/part-of: kubernetes-event-exporter
---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: kubernetes-event-exporter
  namespace: {{ journal_forwarder_k3s_event_exporter_namespace }}
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRole
metadata:
  name: kubernetes-event-exporter
rules:
  - apiGroups: ["*"]
    resources: ["*"]
    verbs: ["get", "list", "watch"]
  - apiGroups: ["coordination.k8s.io"]
    resources: ["leases"]
    verbs: ["get", "create", "update"]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRoleBinding
metadata:
  name: kubernetes-event-exporter
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: ClusterRole
  name: kubernetes-event-exporter
subjects:
  - kind: ServiceAccount
    name: kubernetes-event-exporter
    namespace: {{ journal_forwarder_k3s_event_exporter_namespace }}
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: kubernetes-event-exporter
  namespace: {{ journal_forwarder_k3s_event_exporter_namespace }}
data:
  config.yaml: |
    logLevel: warn
    logFormat: json
    metricsNamePrefix: event_exporter_
    maxEventAgeSeconds: 300
    route:
      routes:
        - match:
            - receiver: file
    receivers:
      - name: file
        file:
          path: {{ journal_forwarder_k3s_event_exporter_log_path }}
          maxsize: 100
          maxage: 7
          maxbackups: 3
          deDot: true
          layout:
{% raw %}            message: "{{ .Message }}"
            reason: "{{ .Reason }}"
            type: "{{ .Type }}"
            count: "{{ .Count }}"
            involved_kind: "{{ .InvolvedObject.Kind }}"
            involved_name: "{{ .InvolvedObject.Name }}"
            namespace: "{{ .Namespace }}"
            component: "{{ .Source.Component }}"
            host: "{{ .Source.Host }}"
            event_timestamp: "{{ .GetTimestampISO8601 }}"
            event_source: "kubernetes_event"
{% endraw %}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: kubernetes-event-exporter
  namespace: {{ journal_forwarder_k3s_event_exporter_namespace }}
  labels:
    app.kubernetes.io/name: kubernetes-event-exporter
spec:
  replicas: 1
  selector:
    matchLabels:
      app.kubernetes.io/name: kubernetes-event-exporter
  template:
    metadata:
      labels:
        app.kubernetes.io/name: kubernetes-event-exporter
    spec:
      serviceAccountName: kubernetes-event-exporter
      hostNetwork: {{ journal_forwarder_k3s_event_exporter_host_network | bool | ternary('true', 'false') }}
      dnsPolicy: ClusterFirstWithHostNet
      securityContext:
        runAsNonRoot: true
        seccompProfile:
          type: RuntimeDefault
      initContainers:
        - name: prepare-event-log
          image: docker.io/library/alpine:3.22
          imagePullPolicy: IfNotPresent
          command: ["/bin/sh", "-c", "install -d -o 65532 -g 65532 -m 0750 {{ journal_forwarder_k3s_event_exporter_log_path | dirname }}"]
          securityContext:
            runAsUser: 0
            runAsNonRoot: false
            allowPrivilegeEscalation: false
            capabilities:
              drop: ["ALL"]
              add: ["CHOWN", "FOWNER", "DAC_OVERRIDE"]
          volumeMounts:
            - name: event-log
              mountPath: {{ journal_forwarder_k3s_event_exporter_log_path | dirname }}
      containers:
        - name: kubernetes-event-exporter
          image: {{ journal_forwarder_k3s_event_exporter_image }}
          imagePullPolicy: IfNotPresent
          args: ["-conf=/data/config.yaml"]
          securityContext:
            runAsUser: 65532
            runAsNonRoot: true
            allowPrivilegeEscalation: false
            capabilities:
              drop: ["ALL"]
          resources:
            requests:
              cpu: 10m
              memory: 32Mi
            limits:
              cpu: 100m
              memory: 128Mi
          volumeMounts:
            - name: config
              mountPath: /data
              readOnly: true
            - name: event-log
              mountPath: {{ journal_forwarder_k3s_event_exporter_log_path | dirname }}
      volumes:
        - name: config
          configMap:
            name: kubernetes-event-exporter
        - name: event-log
          hostPath:
            path: {{ journal_forwarder_k3s_event_exporter_log_path | dirname }}
            type: DirectoryOrCreate
